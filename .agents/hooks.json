{
  "auto-handoff-resume": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ../.claude/hooks/auto-resume.sh"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ../.claude/hooks/telemetry-tracker.sh --hook-stdin prompt"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ../.claude/hooks/telemetry-tracker.sh --hook-stdin stop"
      }
    ]
  },
  "command-and-loop-guards": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ../.claude/hooks/validate-bash.sh"
          },
          {
            "type": "command",
            "command": "bash ../.claude/hooks/loop-circuit-breaker.sh"
          }
        ]
      },
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash ../.claude/hooks/protect-sensitive-files.sh"
          }
        ]
      },
      {
        "matcher": "read_file|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "bash ../.claude/hooks/telemetry-tracker.sh --hook-stdin read"
          }
        ]
      },
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ../.claude/hooks/telemetry-tracker.sh --hook-stdin agent"
          }
        ]
      }
    ]
  },
  "post-edit-checkpoint-and-format": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash ../.claude/hooks/post-edit-format.sh"
          }
        ]
      }
    ]
  }
}
